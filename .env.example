# Supabase Configuration
# Conecta la plataforma de torneos a tu proyecto en Supabase (PostgreSQL 15 + RLS + Realtime)
# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Backend (Express / Vercel Serverless)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Llave administrativa del backend (usar SUPABASE_SERVICE_ROLE_KEY o SUPABASE_SECRET_KEY)
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Configuración de Servidor y CORS
NODE_ENV=production
ALLOWED_ORIGINS=https://arena.tudominio.com,https://apbey.vercel.app

# Edge Function: send-invitation (Supabase Secrets)
# Configurar vía: supabase secrets set RESEND_API_KEY=... INVITATION_FROM_EMAIL=... APP_URL=...
RESEND_API_KEY=
INVITATION_FROM_EMAIL=invitaciones@tudominio.com
APP_URL=https://arena.tudominio.com

# Google Gemini API Key (Opcional, para análisis de torneos y recomendaciones)
GEMINI_API_KEY=
