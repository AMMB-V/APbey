# Supabase Configuration
# Conecta la plataforma de torneos a tu proyecto en Supabase (PostgreSQL 15 + RLS + Realtime)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
ALLOWED_ORIGINS=http://localhost:3000

# (Opcional) Service Role Key para operaciones de mantenimiento o migraciones backend
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key (para asistentes y análisis de torneos si aplica)
GEMINI_API_KEY=
